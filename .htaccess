# ============================================================
#  Security hardening — Apache (cPanel / shared hosting / VPS)
#  Web root: this folder.  Site files stay plain readable text.
# ============================================================

# ---------- 1. Force HTTPS for every request ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Behind a proxy/load balancer (Netlify, Cloudflare, nginx front)
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- 2. HSTS: force HTTPS for 1 year, preload-ready ----------
# Add "; preload" only once every subdomain is on HTTPS, then submit the
# domain at hstspreload.org — it cannot be undone for a year.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---------- 3. Security response headers ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header unset X-Powered-By

    # Content-Security-Policy
    #   'unsafe-inline' in script-src is only there for the small
    #   `tailwind.config = {...}` block. cdn.tailwindcss.com needs no
    #   'unsafe-eval' (verified: no eval/new Function in the bundle).
    #   worker-src blob: is required — the anti-DevTools guard starts a
    #   Blob worker to run its debugger trap.
    #   If you ever need to embed the site in an iframe, change
    #   frame-ancestors 'none' to 'self'.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
</IfModule>

# ---------- 4. Never serve secrets: dotfiles (.env, .git, .htaccess…) ----------
<FilesMatch "(^\.|\.(env|git|log|key|pem|sql|bak|ini|conf|json|lock|md|example)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------- 5. Never serve the backend folder or its dependencies ----------
RedirectMatch 404 ^/discord-bot(/|$)
RedirectMatch 404 ^/node_modules(/|$)
RedirectMatch 404 ^/api(/|$)
RedirectMatch 404 ^/\.netlify(/|$)

# ---------- 5b. Never serve source maps ----------
# The bundle ships without maps, but if a future build (or a dev server)
# emits one it must not be readable.
RedirectMatch 404 (?i)\.(js|css)\.map$
RedirectMatch 404 (?i)\.map$

# ---------- 6. No directory listing ----------
Options -Indexes

# ---------- 7. Server banner off ----------
ServerSignature Off

# ---------- 8. Do not advertise the framework ----------
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>
